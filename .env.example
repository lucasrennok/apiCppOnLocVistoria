# --- API ---
API_PORT=8080
# Obrigatório (mín. 32 chars). Gere com: openssl rand -hex 32
JWT_SECRET=
# DEV: define a senha dos usuários do seed (analista@/gestor@onloc.com.br). Remova em produção.
SEED_DEFAULT_PASSWORD=
# Custo do PBKDF2 (padrão 210000)
# PBKDF2_ITERATIONS=210000

# --- MySQL ---
DB_NAME=appdb
DB_USER=app
DB_PASSWORD=troque_esta_senha
DB_ROOT_PASSWORD=troque_esta_senha_root

# --- Storage S3 (RustFS local; upload via URL pré-assinada) ---
# Credenciais inventadas por você (local). Em produção seriam as do S3/R2 real.
S3_ACCESS_KEY=onloc-admin
S3_SECRET_KEY=troque-esta-chave-minio
S3_BUCKET=onloc
S3_REGION=us-east-1
# URL pela qual o NAVEGADOR alcança o MinIO (sem path no final)
S3_PUBLIC_ENDPOINT=http://localhost:9000
